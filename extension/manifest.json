{
  "manifest_version": 3,
  "name": "LinkLet",
  "version": "0.1.0",
  "minimum_chrome_version": "127",
  "description": "Connect your Telegram private chat to a small browser popup.",
  "permissions": ["alarms", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "LinkLet",
    "default_popup": "popup.html"
  }
}
