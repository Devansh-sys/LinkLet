# LinkLet environment template.
# Copy to .env and fill in. Loaded by `npm start` / `npm run pair`
# via `node --env-file-if-exists=.env`. Shell values win over this file.

# --- required for normal operation -------------------------------------------

# HTTP port the server listens on. Default: 3000
PORT=3000

# HMAC key for signing JWTs. Any long random string.
# Changing it invalidates every issued token; there is no rotation in v1.
# Generate: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-48-byte-hex

# BotFather token. Never commit the real value. Shape: <digits>:<base64ish>
# Leave empty to run without Telegram (polling is skipped).
TELEGRAM_BOT_TOKEN=

# --- optional ----------------------------------------------------------------

# 1 opens POST /dev/ingest for local testing without Telegram.
# Any other value (or unset) keeps it closed. Never enable on a reachable host:
# it accepts a chatId from the caller, which is exactly what the real path forbids.
# DEV_INGEST=1

# Where account bindings + the message id counter persist. Default: state.json
# DATA_FILE=state.json

# Base URL used by `npm run pair` only. Default: http://localhost:3000
# BASE_URL=http://localhost:3000
